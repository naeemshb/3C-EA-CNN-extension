{
  "name": "smoke_synthetic",
  "label": "SMOKE TEST - synthetic two-class images; engineering check only, never a result",
  "dataset": "synthetic",
  "synthetic": {"n_train": 160, "n_val": 40, "n_test": 40, "seed": 0},
  "corruption": {"pattern": "random", "rate": 0.2},
  "backbone": "cnn",
  "metadata_mode": "full",
  "method": {"type": "evolved", "terminals": ["value", "missing", "confidence"]},
  "search": {"population_size": 6, "generations": 2, "max_tree_depth": 3, "mutation_rate": 0.15,
             "crossover_rate": 0.7, "elite_size": 2, "fitness_epochs": 2, "fitness_patience": 2,
             "fitness_batch_size": 32, "fitness_train_subset": null},
  "final": {"epochs": 5, "patience": 3, "batch_size": 32},
  "seeds": {"split": 1000, "corruption": 2000, "evolution": 3000, "init": 4000, "batch": 5000},
  "device": "cpu",
  "out_root": "runs_smoke"
}
